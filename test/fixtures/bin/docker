#!/usr/bin/env python3
import json
import os
import sys
from pathlib import Path


def main() -> int:
    output_path = os.environ.get("CFNLINT_DOCKER_TEST_OUTPUT")
    if output_path:
        payload = {"args": sys.argv[1:]}
        Path(output_path).write_text(json.dumps(payload))

    return int(os.environ.get("CFNLINT_DOCKER_TEST_RC", "0"))


if __name__ == "__main__":
    sys.exit(main())
